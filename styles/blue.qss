/* Azul: Estilo general */
QWidget {
    background-color: #342e82;
    color: #ffffff;
}

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #3f4660;
    color: #ffffff;
    border: 1px solid #3f4660;
    border-radius: 5px;
    padding: 5px;
}

QComboBox {
    background-color: #3f4660;
    color: #ffffff;
    border: 1px solid #3f4660;
    border-radius: 5px;
    padding: 5px 5px 5px 7px;
    min-height: 22px;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
}

QCheckBox::indicator:unchecked {
    border: 1px solid #3f4660;
    background-color: #3f4660;
    border-radius: 3px;
}

QCheckBox::indicator:checked {
    border: 1px solid #3f4660;
    background-color: #66ccff;
    border-radius: 3px;
}

QStatusBar {
    background-color: #3f4660;
    color: #ffffff;
}

QSplitter::handle {
    background-color: #3f4660;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

QProgressBar {
    border: 1px solid #3f4660;
    border-radius: 5px;
    background-color: #3f4660;
    text-align: center;
    color: #ffffff;
}

QProgressBar::chunk {
    background-color: #ff8066;
    width: 1px;
}